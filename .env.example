# Global Docker & Environment Configuration Example
# Copy to .env for local Docker configuration

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=intelligent_grievance
POSTGRES_PORT=5433

# Node Backend Service
PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/intelligent_grievance
JWT_SECRET=super-secret-key-grievance-system-2026-academic-mvp
JWT_EXPIRES_IN=1d
AI_SERVICE_URL=http://localhost:8001
CLIENT_URL=http://localhost:5173

# Python AI Microservice
AI_PORT=8001

# React Frontend
VITE_API_BASE_URL=http://localhost:5000/api/v1
