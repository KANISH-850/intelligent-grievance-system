# AI Service Environment Configuration

# Service Prefix & Limits
API_PREFIX=/api/v1
MIN_TEXT_LENGTH=3
MAX_TEXT_LENGTH=5000

# Classification Confidence Thresholds
AI_CONFIDENCE_THRESHOLD=0.75
AI_LOW_CONFIDENCE_THRESHOLD=0.50

# Translation Provider Configuration
# Supported providers: local_rule_based, libretranslate
TRANSLATION_PROVIDER=libretranslate
TRANSLATION_API_URL=https://libretranslate.de/translate
TRANSLATION_API_KEY=

# Computer Vision Model (In-Process PyTorch)
# Defect classification is powered locally by fine-tuned MobileNetV3-Small-Civic (9 classes).
# No external vision API keys or cloud endpoints required.

