PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/intelligent_grievance
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
AI_SERVICE_URL=http://localhost:8001
# Directory for locally-stored grievance images (absolute path recommended for production)
# Leave unset to use the default ./backend/uploads/ relative to the project root
UPLOAD_DIR=
# Translation and vision configuration is read by the AI service, not the frontend.
