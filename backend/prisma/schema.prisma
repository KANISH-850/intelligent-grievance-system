// Prisma Schema for Intelligent Grievance System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CITIZEN
  OFFICER
  ADMIN
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Status {
  SUBMITTED
  ASSIGNED
  UNDER_REVIEW
  IN_PROGRESS
  PARTIALLY_RESOLVED
  RESOLVED
  REJECTED
}

model User {
  id            String      @id @default(uuid())
  name          String
  email         String      @unique
  password_hash String
  role          Role        @default(CITIZEN)
  department_id String?
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt

  department             Department?                    @relation(fields: [department_id], references: [id], onDelete: SetNull)
  grievances             Grievance[]
  status_changes         GrievanceStatusHistory[]
  notifications          Notification[]
  department_assignments GrievanceDepartmentAssignment[] @relation("OfficerDepartmentAssignments")
  assignment_histories   GrievanceAssignmentHistory[]

  @@map("users")
}

model Department {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  users                User[]
  grievances           Grievance[]
  assignments          GrievanceDepartmentAssignment[]
  assignment_histories GrievanceAssignmentHistory[]

  @@map("departments")
}

model Grievance {
  id                String   @id @default(uuid())
  grievance_number  String   @unique
  user_id           String
  original_text     String   @db.Text
  detected_language String?
  detected_language_code String?
  translated_text   String?  @db.Text
  translation_status String? @default("unavailable")
  translation_method String?
  translation_error  String?  @db.Text
  translated_at      DateTime?
  category          String
  routing_status    String   @default("ASSIGNED")
  priority          Priority @default(MEDIUM)
  department_id     String
  status                  Status   @default(SUBMITTED)

  // Phase 11 — AI Confidence, Review & Explainability Metadata
  ai_confidence           Float?
  ai_confidence_level     String?
  ai_review_required      Boolean  @default(false)
  ai_classification_method String?
  ai_explanation_terms    String[] @default([])
  ai_original_category    String?
  is_human_corrected      Boolean  @default(false)
  human_corrected_by      String?
  human_corrected_at      DateTime?

  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  user           User                     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  department     Department               @relation(fields: [department_id], references: [id], onDelete: Restrict)
  status_history GrievanceStatusHistory[]
  notifications  Notification[]
  images               GrievanceImage[]
  assignments          GrievanceDepartmentAssignment[]
  assignment_histories GrievanceAssignmentHistory[]

  @@map("grievances")
}

model GrievanceDepartmentAssignment {
  id                  String      @id @default(uuid())
  grievance_id        String
  department_id       String
  status              Status      @default(ASSIGNED)
  routing_reason      String?     @db.Text
  assigned_officer_id String?
  notes               String?     @db.Text
  remarks             String?     @db.Text
  resolution_description String?  @db.Text
  started_at          DateTime?
  resolved_at         DateTime?
  created_at          DateTime    @default(now())
  updated_at          DateTime    @updatedAt

  grievance           Grievance   @relation(fields: [grievance_id], references: [id], onDelete: Cascade)
  department          Department  @relation(fields: [department_id], references: [id], onDelete: Restrict)
  assigned_officer    User?       @relation("OfficerDepartmentAssignments", fields: [assigned_officer_id], references: [id], onDelete: SetNull)
  history             GrievanceAssignmentHistory[]

  @@unique([grievance_id, department_id])
  @@index([department_id])
  @@index([grievance_id])
  @@map("grievance_department_assignments")
}

model GrievanceAssignmentHistory {
  id              String                        @id @default(uuid())
  assignment_id   String
  grievance_id    String
  department_id   String
  previous_status Status?
  status          Status
  remarks         String?                       @db.Text
  changed_by      String
  created_at      DateTime                      @default(now())

  assignment      GrievanceDepartmentAssignment @relation(fields: [assignment_id], references: [id], onDelete: Cascade)
  grievance       Grievance                     @relation(fields: [grievance_id], references: [id], onDelete: Cascade)
  department      Department                    @relation(fields: [department_id], references: [id], onDelete: Restrict)
  user            User                          @relation(fields: [changed_by], references: [id], onDelete: Cascade)

  @@index([assignment_id])
  @@index([grievance_id])
  @@index([department_id])
  @@map("grievance_assignment_history")
}

model GrievanceStatusHistory {
  id           String   @id @default(uuid())
  grievance_id String
  status       Status
  remarks      String?  @db.Text
  changed_by   String
  created_at   DateTime @default(now())

  grievance Grievance @relation(fields: [grievance_id], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [changed_by], references: [id], onDelete: Cascade)

  @@map("grievance_status_history")
}

enum NotificationType {
  GRIEVANCE_SUBMITTED
  GRIEVANCE_ASSIGNED
  STATUS_CHANGED
  HIGH_PRIORITY
  CRITICAL_PRIORITY
  GRIEVANCE_RESOLVED
  GRIEVANCE_REJECTED
}

model Notification {
  id           String           @id @default(uuid())
  user_id      String
  grievance_id String?
  type         NotificationType
  title        String
  message      String           @db.Text
  is_read      Boolean          @default(false)
  created_at   DateTime         @default(now())

  user      User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  grievance Grievance? @relation(fields: [grievance_id], references: [id], onDelete: SetNull)

  @@map("notifications")
}

model GrievanceImage {
  id           String   @id @default(uuid())
  grievance_id String
  filename     String
  mime_type    String
  size         Int
  path         String
  analysis_status String? @default("pending")
  image_description String? @db.Text
  detected_issue String?
  visual_observations String[] @default([])
  analysis_confidence Float?
  human_review_required Boolean @default(true)
  uploaded_at  DateTime @default(now())

  grievance    Grievance @relation(fields: [grievance_id], references: [id], onDelete: Cascade)

  @@map("grievance_images")
}
